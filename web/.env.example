# Base URL of the Shippopotamus Labs API (Go service).
# Dev default when unset: http://localhost:8080
# Production: set this at build time to the Cloud Run URL, e.g.
# VITE_API_BASE_URL=https://shippopotamus-api-XXXX.us-east1.run.app
VITE_API_BASE_URL=http://localhost:8080

# Firebase Web app (public config only) for /enclave/subscribe Google sign-in.
# Create a Web app in Firebase console for project enclave-497101; leave empty locally
# until configured. Never put Stripe or Admin credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
